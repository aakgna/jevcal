# Copy to .env and fill in the keys you have. Never commit .env itself.

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
# Used by examples/gateway-basic, examples/vercel-ai-middleware, and JevAdapter's
# "gateway" transport (no separate TypeSafe account needed for that one).
AI_GATEWAY_API_KEY=

# OpenAI directly — used by examples/langchain-callback.
OPENAI_API_KEY=

# TypeSafe AI — https://docs.typesafe.ai — used by JevAdapter's "direct" transport.
JEV_API_KEY=
