{
  "name": "@jevcal/adapter-jev",
  "version": "0.2.0",
  "description": "jevcal backend adapter for Typesafe AI's Jev model via the Vercel AI Gateway's evaluation-model interface (ai@7 experimental_evaluate) — maps typed decision fields onto choice/score/boolean questions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jevcal/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ai": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
